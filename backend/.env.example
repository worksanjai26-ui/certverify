# Local development: copy to backend/.env and adjust.
# On Vercel, set these in Project > Settings > Environment Variables instead (see README "Deploy to Vercel").
PORT=4000

# Base URL printed into every certificate's QR code. On Vercel it defaults to the production domain.
#   dev (Vite):            http://localhost:5173
#   phone on same Wi-Fi:   http://<your-LAN-IP>:5173
PUBLIC_URL=http://localhost:5173

INSTITUTION_NAME=Demo Institute of Technology

# Seed registrar account, created on first run only. Change before any real use.
ADMIN_EMAIL=registrar@college.test
ADMIN_PASSWORD=ChangeMe!2026

# --- Production storage (required on Vercel; leave unset locally to use backend/data/) ---
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token from `turso db tokens create` or the Turso dashboard>
# INSTITUTION_PRIVATE_KEY=<output of `npm run key:export`>
# MAX_UPLOAD_MB=4
