# Copy to backend/.env and adjust.
PORT=4000

# Base URL printed into each certificate's QR code. Use the address employers will open:
#   dev (Vite):            http://localhost:5173
#   built app (npm start): http://localhost:4000
#   phone on same Wi-Fi:   http://<your-LAN-IP>:5173
PUBLIC_URL=http://localhost:5173

INSTITUTION_NAME=Demo Institute of Technology

# Seed registrar account, created on first run only. Change before any real use.
ADMIN_EMAIL=registrar@college.test
ADMIN_PASSWORD=ChangeMe!2026
